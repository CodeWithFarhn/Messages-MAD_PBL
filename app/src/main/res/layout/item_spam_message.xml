<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/spam_item_holder"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/activity_margin"
    android:paddingTop="@dimen/medium_margin"
    android:paddingEnd="@dimen/activity_margin"
    android:paddingBottom="@dimen/medium_margin">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <org.fossify.commons.views.MyTextView
            android:id="@+id/spam_sender"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_toStartOf="@+id/spam_date"
            android:textSize="@dimen/bigger_text_size"
            android:textStyle="bold"
            tools:text="+92 300 1234567" />

        <org.fossify.commons.views.MyTextView
            android:id="@+id/spam_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:alpha="0.7"
            android:textSize="@dimen/small_text_size"
            tools:text="Nov 7, 5:30 PM" />

    </RelativeLayout>

    <org.fossify.commons.views.MyTextView
        android:id="@+id/spam_snippet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/tiny_margin"
        android:ellipsize="end"
        android:maxLines="3"
        android:textSize="@dimen/normal_text_size"
        tools:text="Congratulations! You have won Rs 50,000 cash in lucky draw." />

    <org.fossify.commons.views.MyTextView
        android:id="@+id/spam_reasons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/tiny_margin"
        android:alpha="0.75"
        android:textSize="@dimen/smaller_text_size"
        android:textStyle="italic"
        tools:text="Score: 70 • Prize language" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/small_margin"
        android:gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/spam_action_not_spam"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/not_spam" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/spam_action_delete"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/small_margin"
            android:text="@string/delete"
            android:textColor="?attr/colorError" />

    </LinearLayout>

    <include layout="@layout/divider" />

</LinearLayout>

